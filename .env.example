# PostgreSQL
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_dev_password
POSTGRES_PORT=5432
# Mỗi service tạo DB riêng (auth_db, user_db, ...). Đây là DB khởi tạo mặc định.
POSTGRES_DB=postgres

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# Kafka (KRaft)
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=ecom-local-cluster-0001

# Kafka UI
KAFKA_UI_PORT=8080

# Product service
PRODUCT_PORT=5033
PRODUCT_DB=product_db
PRODUCT_ENVIRONMENT=Development
# Auth service
AUTH_PORT=5044
AUTH_DB=auth_db
AUTH_ENVIRONMENT=Development
# Issuer phải giống hệt nhau trong và ngoài Docker.
# Cần một dòng "127.0.0.1 auth" trong hosts file - xem README.
AUTH_ISSUER=http://auth:5044
AUTH_SERVICE_WORKER_SECRET=service_worker_dev_secret
# Mật khẩu PFX. Chạy scripts/gen-auth-certs.sh trước lần `make up` đầu tiên.
AUTH_CERT_PASSWORD=auth_cert_dev_password
