@page
@model Ecommerce.Auth.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<h1>Đăng nhập</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="error">@Model.ErrorMessage</p>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" autocomplete="username" autofocus/>

    <label asp-for="Input.Password">Mật khẩu</label>
    <input asp-for="Input.Password" autocomplete="current-password"/>

    <button type="submit">Đăng nhập</button>

    <div asp-validation-summary="ModelOnly" class="hint"></div>
</form>

@if (Model.HttpContext.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment())
{
    <p class="hint">
        Tài khoản dev: <code>admin@ecom.local</code> / <code>Admin@123456</code>
    </p>
}
