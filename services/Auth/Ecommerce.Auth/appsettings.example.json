{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=auth_db;Username=ecom;Password=__SET_IN_USER_SECRETS_OR_ENV__"
  },
  "Auth": {
    "Issuer": "http://auth:5044",
    "WebClient": {
      "RedirectUris": [
        "http://localhost:5044/swagger/oauth2-redirect.html",
        "http://auth:5044/swagger/oauth2-redirect.html",
        "https://oauth.pstmn.io/v1/callback",
        "https://localhost:5173/callback"
      ],
      "PostLogoutRedirectUris": [
        "http://localhost:5044/",
        "http://auth:5044/",
        "https://localhost:5173/"
      ]
    },
    "ServiceWorker": {
      "Secret": "__SET_IN_USER_SECRETS_OR_ENV__"
    },
    "Certificates": {
      "Path": "",
      "Password": "__SET_IN_USER_SECRETS_OR_ENV__",
      "ExpiryWarningDays": 30
    },
    "RateLimit": {
      "LoginPermitLimit": 10
    },
    "Pruning": {
      "Enabled": true,
      "IntervalHours": 12,
      "RetentionDays": 14
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownNetworks": [],
      "KnownProxies": [],
      "ForwardLimit": 1
    }
  }
}
